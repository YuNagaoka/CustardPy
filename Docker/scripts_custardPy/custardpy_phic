#!/bin/bash
set -euo pipefail

printHelpAndExit() {
    echo "Usage: ${0##*/} <outputdir> <hic> <chr> <start> <end> <resolution> <norm> [tolerance]"
    echo "  <outputdir>: directory where the PHi-C2 output directory will be created"
    echo "  <hic>: input Hi-C file (.hic or .mcool)"
    echo "  <chr> <start> <end>: chromosome, start and end positions for simulation"
    echo "  <resolution>: resolution of the matrix"
    echo "  <norm>: normalization type (NONE|VC|VC_SQRT|KR|SCALE)"
    echo "  [tolerance]: NaN filtering threshold for phic preprocessing (default: 0.4)"
    echo "  Example:"
    echo "     ${0##*/} JuicerResults/sample1 JuicerResults/sample1/aligned/inter_30.hic 21 24000000 32000000 25000 KR 0.4"
    exit 0
}

if [ $# -lt 7 ] || [ $# -gt 8 ]; then
    printHelpAndExit
fi

odir=$1
hic=$2
chr=$3
start=$4
end=$5
resolution=$6
norm=$7
tolerance=${8:-0.4}

plt_max_c=0.1
plt_max_k=0.1
interval=100
frame=1000
sample=1000

mkdir -p "$odir"
cd "$odir"

hicbase=$(basename "$hic")
hicbase=${hicbase%.*}
name="${hicbase}_${norm}_chr${chr}_${start}-${end}_res${resolution}bp"

echo "Inspect Hi-C file..."
phic fetch-fileinfo --input "$hic"

echo "Start 4D simulation by PHi-C2..."
phic preprocessing \
    --input "$hic" \
    --res "$resolution" \
    --plt-max-c "$plt_max_c" \
    --chr "$chr" \
    --grs "$start" \
    --gre "$end" \
    --norm "$norm" \
    --tolerance "$tolerance"

phic optimization --name "$name"
phic plot-optimization --name "$name" --plt-max-c "$plt_max_c" --plt-max-k "$plt_max_k"
phic dynamics --name "$name" --interval "$interval" --frame "$frame"
phic sampling --name "$name" --sample "$sample"
echo "done."

echo "Estimate dynamics-derived spectra..."
phic msd --name "$name"
phic plot-msd --name "$name" --plt-upper 3 --plt-lower 0 --plt-max-log 2.0 --plt-min-log 0.5 --aspect 1.5
phic losstangent --name "$name"
phic plot-losstangent --name "$name" --plt-upper 0 --plt-lower -3 --plt-max-log 0.3 --aspect 1.5
echo "done."

echo "Generate Hi-C map movie..."
N=$(( (end - start) / resolution + 1 ))
plot_distance_map.py "$name/data_dynamics/sample0.xyz" "$N" "$frame" "$name/distance_map/"

if command -v ffmpeg >/dev/null 2>&1; then
    ffmpeg -framerate 24 -i "$name/distance_map/frame_%04d.jpg" -pix_fmt yuv420p \
          -c:v libx264 -preset slow -crf 24 -r 24 \
          -vf "scale=trunc(iw/2)*2:trunc(ih/2)*2" \
          "$name/distance_map/movie.mp4"
else
    echo "ffmpeg not found; skipping movie generation."
fi

echo "done."
